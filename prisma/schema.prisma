generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id            Int       @id @default(autoincrement())
  walletAddress String?   @unique @map("wallet_address")
  email         String    @unique @db.VarChar(100)
  password      String
  username      String    @unique @db.VarChar(100)
  language      Language  @default(ENGLISH)
  createdAt     DateTime  @default(now()) @map("created_at")
  resetToken        String?   @map("reset_token")
  resetTokenExpiry  DateTime? @map("reset_token_expiry")
  watch               Watch[]
  ownershipLog        OwnershipLog[]
  transfersFrom       TransferRequest[] @relation("transferFrom")
  transfersTo         TransferRequest[] @relation("transferTo")

  @@map("Users")
}

model Watch{
  id              Int       @id @default(autoincrement())
  user            User      @relation(fields: [ownerId], references: [id])
  ownerId         Int       @map("owner_id")
  serialNum       String    @unique @map("serial_num")
  brand           String?
  model           String?
  referenceNumber String?   @map("reference_number")
  yearOfProduction Int?     @map("year_of_production")
  imageUrl        String?   @map("image_url")
  metadataURI     String?   @map("metadata_uri")
  tokenId         String?   @map("token_id")
  txHash          String?   @map("tx_hash")
  mintStatus      MintStatus @default(PENDING) @map("mint_status")
  lastSynced         DateTime  @map("last_synced")
  ownershipLog       OwnershipLog[]
  transferRequests   TransferRequest[]

  @@map("Watchs")
}

model OwnershipLog{
  id            Int       @id @default(autoincrement())
  watch         Watch     @relation(fields: [watchId], references: [id])
  watchId       Int       @map("watch_id")
  owner         User      @relation(fields: [ownerId], references: [id])
  ownerId       Int       @map("owner_id")
  metadataURI   String?   @map("metadata_uri")
  timestamp     DateTime  @default(now())

  @@map("Ownershiplogs")
}

model TransferRequest {
  id            Int             @id @default(autoincrement())
  watch         Watch           @relation(fields: [watchId], references: [id])
  watchId       Int             @map("watch_id")
  fromUser      User            @relation("transferFrom", fields: [fromUserId], references: [id])
  fromUserId    Int             @map("from_user_id")
  toUser        User            @relation("transferTo", fields: [toUserId], references: [id])
  toUserId      Int             @map("to_user_id")
  status        TransferStatus  @default(PENDING)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("TransferRequests")
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum Language {
  SPANISH
  ENGLISH
}

enum MintStatus {
  PENDING
  MINTED
  FAILED
}
