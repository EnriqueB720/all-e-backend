generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
  id            Int       @id @default(autoincrement())
  walletAddress String?   @unique @map("wallet_address")
  email         String    @unique @db.VarChar(100)
  password      String
  username      String    @unique @db.VarChar(100)
  language      Language  @default(ENGLISH)
  createdAt     DateTime  @default(now()) @map("created_at")
  resetToken        String?   @map("reset_token")
  resetTokenExpiry  DateTime? @map("reset_token_expiry")
  watch         Watch[]
  ownershipLog  OwnershipLog[]

  @@map("Users")
}

model Watch{
  id            Int       @id @default(autoincrement())
  user          User      @relation(fields: [ownerId], references: [id])
  ownerId       Int       @map("owner_id")
  serialNum     String    @unique @map("serial_num")
  metadataURI   String?   @map("metadata_uri")
  tokenId       String?   @map("token_id")
  txHash        String?   @map("tx_hash")
  mintStatus    MintStatus @default(PENDING) @map("mint_status")
  lastSynced    DateTime  @map("last_synced")
  ownershipLog  OwnershipLog[]

  @@map("Watchs")
}

model OwnershipLog{
  id            Int       @id @default(autoincrement())
  watch         Watch     @relation(fields: [watchId], references: [id])
  watchId       Int       @map("watch_id")
  owner         User      @relation(fields: [ownerId], references: [id])
  ownerId       Int       @map("owner_id")
  timestamp     DateTime  @default(now())

  @@map("Ownershiplogs")
}

enum Language {
  SPANISH
  ENGLISH
}

enum MintStatus {
  PENDING
  MINTED
  FAILED
}
